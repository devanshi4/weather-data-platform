[0m21:07:23.279744 [debug] [Thread-3 (]: On model.weather.fct_weather_hourly: create or replace transient table WEATHER_DB.ANALYTICS.fct_weather_hourly
    
    
    
    as (with staged as (

    select * from WEATHER_DB.ANALYTICS.stg_weather

)

select
    -- a surrogate key: one unique id per city-hour, built by hashing the two
    md5(city || '-' || observed_at)  as weather_key,

    -- links to the dimensions
    city                             as city,
    date(observed_at)                as date_day,

    -- when it happened
    observed_at,

    -- the measurements (the "facts")
    temperature_c,
    humidity_pct,
    wind_speed,
    precipitation
from staged
    )

