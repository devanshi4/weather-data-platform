# Copy to .env and fill in. .env is git-ignored.
# Extractor (api.py / Lambda)
S3_BUCKET=your-raw-bucket
AWS_REGION=us-east-1

# dbt / Snowflake (key-pair auth: put rsa_key.p8 in ./keys/, which is git-ignored)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_private_key_passphrase_or_password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WEATHER_DB
SNOWFLAKE_SCHEMA=ANALYTICS
